+  --chart-5: #35654a;
+}
+html.dark {
+  --background: #151719;
+  --foreground: #f5f4f0;
+  --card: #1d2022;
+  --card-foreground: #f5f4f0;
+  --popover: #1d2022;
+  --popover-foreground: #f5f4f0;
+  --primary: #bd3020;
+  --primary-foreground: #ffffff;
+  --muted: #282c2f;
+  --muted-foreground: #cacbc6;
+  --accent: #3b2723;
+  --accent-foreground: #ffb3a4;
+  --border: #4c5154;
+  --input: #4c5154;
+  --input-background: #1d2022;
+  --ring: #ff927e;
+  --danger-soft: #382328;
+  --success: #9ad6b0;
+  --success-soft: #203329;
+  --warning: #e5c47e;
+  --warning-soft: #342e20;
+  --destructive: #ff9ca3;
+  --destructive-foreground: #291216;
+  --chart-2: #9cc9d0;
+  --chart-3: #c9c391;
+  --chart-4: #dca4b1;
+  --chart-5: #9ad6b0;
+}
+/* Adapt the existing inline palette without changing feature behavior. */
+html .admin-ui [style*="background: rgb(255, 255, 255)"] { background: var(--card) !important; }
+html .admin-ui [style*="background: rgb(248, 247, 243)"] { background: var(--background) !important; }
+html .admin-ui [style*="color: rgb(45, 26, 14)"],
+html .admin-ui [style*="color: rgb(45, 36, 29)"],
+html .admin-ui [style*="color: rgb(67, 58, 49)"] { color: var(--foreground) !important; }
+html .admin-ui [style*="color: rgb(199, 169, 138)"],
+html .admin-ui [style*="color: rgb(122, 92, 46)"],
+html .admin-ui [style*="color: rgb(161, 123, 88)"],
+html .admin-ui [style*="color: rgb(117, 104, 91)"],
+html .admin-ui [style*="color: rgb(120, 83, 51)"],
+html .admin-ui [style*="color: rgb(130, 118, 106)"],
+html .admin-ui [style*="color: rgb(155, 123, 91)"],
+html .admin-ui [style*="color: rgb(101, 88, 72)"],
+html .admin-ui [style*="color: rgb(148, 135, 121)"],
+html .admin-ui [style*="color: rgb(135, 109, 77)"],
+html .admin-ui [style*="color: rgb(122, 108, 93)"] { color: var(--muted-foreground) !important; }
+html .admin-ui [style*="color: rgb(240, 90, 26)"],
+html .admin-ui [style*="color: rgb(217, 83, 22)"],
+html .admin-ui [style*="color: rgb(37, 99, 235)"] { color: var(--accent-foreground) !important; }
+html .admin-ui [style*="background: rgb(240, 90, 26)"],
+html .admin-ui [style*="background: rgb(217, 83, 22)"],
+html .admin-ui [style*="background: rgb(37, 99, 235)"] { background: var(--primary) !important; }
+html .admin-ui [style*="color: rgb(180, 35, 24)"],
+html .admin-ui [style*="color: rgb(239, 68, 68)"],
+html .admin-ui [style*="color: rgb(198, 40, 40)"],
+html .admin-ui [style*="color: rgb(143, 59, 50)"],
+html .admin-ui [style*="color: rgb(235, 87, 87)"],
+html .admin-ui [style*="color: rgb(181, 71, 64)"],
+html .admin-ui [style*="color: rgb(195, 75, 68)"],
+html .admin-ui [style*="color: rgb(208, 92, 82)"] { color: var(--destructive) !important; }
+html .admin-ui [style*="background: rgb(255, 235, 238)"],
+html .admin-ui [style*="background: rgb(255, 240, 237)"],
+html .admin-ui [style*="background: rgb(253, 234, 222)"] { background: var(--danger-soft) !important; }
+html .admin-ui [style*="color: rgb(46, 125, 50)"],
+html .admin-ui [style*="color: rgb(39, 174, 96)"],
+html .admin-ui [style*="color: rgb(21, 132, 91)"],
+html .admin-ui [style*="color: rgb(20, 115, 79)"],
+html .admin-ui [style*="color: rgb(34, 160, 107)"],
+html .admin-ui [style*="color: rgb(34, 132, 91)"],
+html .admin-ui [style*="color: rgb(16, 185, 129)"] { color: var(--success) !important; }
+html .admin-ui [style*="background: rgb(232, 245, 233)"],
+html .admin-ui [style*="background: rgb(234, 247, 238)"],
+html .admin-ui [style*="background: rgb(234, 246, 239)"],
+html .admin-ui [style*="background: rgb(245, 250, 246)"] { background: var(--success-soft) !important; }
+html .admin-ui [style*="color: rgb(217, 119, 6)"],
+html .admin-ui [style*="color: rgb(242, 153, 74)"],
+html .admin-ui [style*="color: rgb(196, 122, 23)"],
+html .admin-ui [style*="color: rgb(182, 107, 18)"],
+html .admin-ui [style*="color: rgb(155, 95, 38)"] { color: var(--warning) !important; }
+html .admin-ui [style*="background: rgb(251, 243, 232)"],
+html .admin-ui [style*="background: rgb(254, 249, 231)"],
+html .admin-ui [style*="background: rgb(255, 249, 239)"] { background: var(--warning-soft) !important; }
+html .admin-ui [style*="background: rgb(253, 240, 232)"],
+html .admin-ui [style*="background: rgb(232, 241, 255)"],
+html .admin-ui [style*="background: rgb(255, 242, 233)"],
+html .admin-ui [style*="background: rgb(255, 240, 232)"],
+html .admin-ui [style*="background: rgb(253, 246, 238)"] { background: var(--accent) !important; }
+html .admin-ui [style*="background: rgb(250, 248, 244)"],
+html .admin-ui [style*="background: rgb(244, 239, 231)"],
+html .admin-ui [style*="background: rgb(241, 238, 232)"],
+html .admin-ui [style*="background: rgb(246, 243, 237)"] { background: var(--muted) !important; }
+
+html body.admin-ui, html .admin-ui #root, html .admin-ui main { background: var(--background) !important; color: var(--foreground); }
+.admin-ui { font-family: var(--font-sans); line-height: 1.5; }
+html .admin-ui :is(aside, header) { background: var(--card) !important; border-color: var(--border) !important; }
+html .admin-ui :is([style*="border:"], [style*="border-bottom:"], [style*="border-top:"], [style*="border-right:"], [style*="border-color:"]) { border-color: var(--border) !important; }
+html .admin-ui :is([style*="box-shadow:"], [class*="shadow"]) { box-shadow: none !important; }
+html .admin-ui :is(.rounded-xl, .rounded-2xl, [style*="border-radius:"]) { border-radius: var(--radius) !important; }
+html .admin-ui :is(h1, h2, h3, h4) { font-weight: 800 !important; line-height: 1.2; }
+.admin-ui :is(h1, h2) { letter-spacing: -0.02em; }
+.admin-ui p { overflow-wrap: anywhere; }
+.admin-ui :is(button, input, select, textarea) { font-family: inherit; }
+.admin-ui :is(button, input:not([type="checkbox"]):not([type="radio"]), select) { min-height: 44px; }
+.admin-ui :is(input, select, textarea) { min-width: 0; }
+html .admin-ui :is(input, select, textarea) { color: var(--foreground); background-color: var(--card); }
+html .admin-ui :is(input, textarea)::placeholder { color: var(--muted-foreground); opacity: 1; }
+.admin-ui button { transition: filter 120ms ease, background-color 120ms ease, color 120ms ease; transform: none !important; }
+.admin-ui button:enabled:hover { filter: brightness(0.94); }
+.admin-ui button:enabled:active { filter: brightness(0.88); }
+.admin-ui button:disabled { cursor: not-allowed; opacity: 0.55; }
+.admin-ui :is(button, a, input, select, textarea, [tabindex]):focus-visible { outline: 2px solid var(--ring) !important; outline-offset: 3px; }
+.admin-ui a { text-underline-offset: 3px; }
+.admin-ui a:hover { text-decoration: underline; }
+.admin-ui :is(table, strong, time, .recharts-wrapper) { font-variant-numeric: tabular-nums; }
+.admin-ui :is(td, th) { vertical-align: top; }
+.admin-ui tbody tr:hover { background: var(--muted); }
+.admin-shell main { scrollbar-gutter: stable; }
+.admin-page { width: 100%; min-width: 0; padding: 24px; }
+.admin-toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
+.admin-toolbar > * { min-width: 0; }
+.admin-tabs { display: flex; flex-wrap: wrap; }
+.admin-table { overflow-x: auto; }
+.admin-table table { min-width: 700px; }
+.admin-ui .admin-intro { font-family: var(--font-editorial); font-size: 1.125rem; line-height: 1.5; }
+.admin-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--border); }
+html .admin-ui .admin-metric { min-width: 0; padding: 20px 16px; background: transparent !important; border: 0 !important; border-radius: 0 !important; }
+html .admin-ui .admin-metric + .admin-metric { border-inline-start: 1px solid var(--border) !important; }
+.admin-metric-icon { display: none; }
+.admin-metric :is(strong, .text-3xl) { font-size: 2rem; font-weight: 800; }
+.admin-metric p { margin-top: 8px; }
+.admin-dialog { width: min(400px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; }
+.admin-vendor-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
+.admin-vendor-heading { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; }
+.admin-menu-form { display: flex; flex-wrap: wrap; gap: 12px; }
+.admin-menu-form input { flex: 1 1 180px !important; }
+.admin-menu-form input[type="number"] { flex-basis: 100px !important; }
+.admin-login { border-top: 4px solid var(--primary) !important; }
+html .admin-ui button[aria-current="page"] { background: var(--accent) !important; color: var(--accent-foreground) !important; }
+html .admin-ui .recharts-cartesian-axis-tick-value { fill: var(--muted-foreground) !important; }
+html .admin-ui .recharts-legend-item-text { color: var(--muted-foreground) !important; }
+html .admin-ui .recharts-cartesian-grid line { stroke: var(--border) !important; }
+html .admin-ui .recharts-default-tooltip { background: var(--popover) !important; color: var(--popover-foreground) !important; border-color: var(--border) !important; }
+html .admin-ui :is(.leaflet-popup-content-wrapper, .leaflet-popup-tip) { background: var(--popover); color: var(--popover-foreground); }
+@media (max-width: 767px) {
+  .admin-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  html .admin-ui .admin-metric:nth-child(3) { border-inline-start: 0 !important; }
+  html .admin-ui .admin-metric:nth-child(n+3) { border-top: 1px solid var(--border) !important; }
+}
+@media (max-width: 639px) {
+  .admin-page { padding: 16px; }
+  .admin-vendor-grid { grid-template-columns: minmax(0, 1fr); }
+  .admin-toolbar > * { flex-basis: 100%; width: 100% !important; }
+  .admin-dialog { padding: 20px; }
+  .admin-vendor-heading > div { width: 100%; }
+  .admin-vendor-heading h2 { overflow-wrap: anywhere; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .admin-ui *, .admin-ui *::before, .admin-ui *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+html .admin-ui svg[color]:not([color="#fff"]):not([color="#FFF"]):not([color="#ffffff"]) { color: var(--muted-foreground); }
+html .admin-ui button[style*="background: rgb(235, 87, 87)"], html .admin-ui button[style*="background: rgb(239, 68, 68)"] { background: #a3242c !important; }
+html .admin-ui button[style*="background: rgb(39, 174, 96)"], html .admin-ui button[style*="background: rgb(16, 185, 129)"] { background: #216441 !important; }
+.admin-ui [data-slot="sheet-overlay"] { z-index: 1100; }
+.admin-ui [data-slot="sheet-content"] { z-index: 1101; overflow-y: auto; }
+.admin-ui [data-slot="sheet-content"] > button { width: 44px; height: 44px; display: grid; place-items: center; top: 10px; right: 8px; }
+.admin-ui [data-slot="sheet-content"] > div:first-of-type + div { padding-right: 52px; }
